POSTGRES_DB=kisamore
POSTGRES_USER=kisamore
POSTGRES_PASSWORD=replace-with-a-long-random-password

KISAMORE_CORS_ORIGINS=https://kisamore-platform.fedalal.chatgpt.site
KISAMORE_OFFLINE_AFTER_SECONDS=120
KISAMORE_SESSION_DAYS=30
KISAMORE_COOKIE_SECURE=true
KISAMORE_OFFER_HOURS=24
KISAMORE_PHOTO_DIR=/srv/kisamore/data/photos
KISAMORE_PHOTO_MAX_BYTES=2097152

KISAMORE_BOOTSTRAP_FARM_SLUG=demo-farm
KISAMORE_BOOTSTRAP_FARM_NAME=KisaMore Farm
KISAMORE_BOOTSTRAP_DEVICE_ID=greenhouse-pi-01
KISAMORE_BOOTSTRAP_DEVICE_NAME=Greenhouse Pi
KISAMORE_BOOTSTRAP_DEVICE_TOKEN=replace-with-at-least-32-random-characters

# Optional MQTT snapshot ingestion. Use host.docker.internal when Mosquitto runs
# directly on the VPS host and this API runs inside Docker.
KISAMORE_MQTT_HOST=
KISAMORE_MQTT_PORT=1883
KISAMORE_MQTT_USERNAME=
KISAMORE_MQTT_PASSWORD=
KISAMORE_MQTT_TLS=false
KISAMORE_MQTT_TOPIC_PREFIX=kisamore

# Individual manual watering. Plant schedule times are interpreted in the
# greenhouse timezone. The worker maintains a 48-hour queue for the admin UI.
KISAMORE_FARM_TIMEZONE=Europe/Moscow
KISAMORE_WATERING_CHECK_SECONDS=300
KISAMORE_WATERING_HORIZON_HOURS=48
KISAMORE_WATERING_LOOKBACK_HOURS=24

# Automatic VPS timelapses. The worker checks every 5 minutes; the application
# itself refreshes 24h videos hourly, 3d videos every 3 hours and full-cycle
# videos every 12 hours. ffmpeg is installed in the cloud Docker image.
KISAMORE_TIMELAPSE_CHECK_SECONDS=300
KISAMORE_TIMELAPSE_PRESET=veryfast
KISAMORE_TIMELAPSE_CRF=23
KISAMORE_TIMELAPSE_FFMPEG_TIMEOUT=180

# Telegram bot. Keep the real token only in cloud/.env on the VPS.
KISAMORE_TELEGRAM_BOT_TOKEN=
KISAMORE_TELEGRAM_BOT_USERNAME=KisaMoreBot
KISAMORE_TELEGRAM_SUPPORT_CONTACT=

# Admin dashboard. The password is only used to create the account the first time.
KISAMORE_ADMIN_EMAIL=admin@example.com
KISAMORE_ADMIN_PASSWORD=replace-with-at-least-12-characters
KISAMORE_ADMIN_NAME=KisaMore Admin

POSTGRES_DB=kisamore
POSTGRES_USER=kisamore
POSTGRES_PASSWORD=replace-with-a-long-random-password

KISAMORE_CORS_ORIGINS=https://kisamore-platform.fedalal.chatgpt.site
KISAMORE_OFFLINE_AFTER_SECONDS=120

KISAMORE_BOOTSTRAP_FARM_SLUG=demo-farm
KISAMORE_BOOTSTRAP_FARM_NAME=KisaMore Farm
KISAMORE_BOOTSTRAP_DEVICE_ID=greenhouse-pi-01
KISAMORE_BOOTSTRAP_DEVICE_NAME=Greenhouse Pi
KISAMORE_BOOTSTRAP_DEVICE_TOKEN=replace-with-at-least-32-random-characters

# Отдельные данные только для публикации видео с Raspberry Pi в MediaMTX.
KISAMORE_MEDIA_PUBLISH_USER=kisamore-edge
KISAMORE_MEDIA_PUBLISH_PASSWORD=replace-with-another-long-random-password

# Действующий TLS-сертификат VPS для защищённой публикации RTSPS.
KISAMORE_TLS_CERT_PATH=/etc/letsencrypt/live/api.kisamore.com/fullchain.pem
KISAMORE_TLS_KEY_PATH=/etc/letsencrypt/live/api.kisamore.com/privkey.pem

# Публичный HTTPS-префикс, который Nginx проксирует на MediaMTX:8888.
KISAMORE_PUBLIC_HLS_BASE_URL=/hls
